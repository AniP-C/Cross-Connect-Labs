---
// Wordmark recreated from the logo set: navy/white text, copper ring, power "o", cable and "labs" pill.
// Swap for the official SVG export when it is available.
interface Props {
  height?: number;
}
const { height = 42 } = Astro.props;
---

<svg class="logo" role="img" aria-label="crossconnect labs" viewBox="0 0 300 92" height={height} width={(height * 300) / 92}>
  <text x="0" y="40">cr</text>
  <text x="72" y="40">ssc</text>
  <text x="168" y="40">nnect</text>
  <g class="copper">
    <path d="M60 38.7 C60 68 156 68 156 38.7"></path>
    <circle cx="60" cy="29.5" r="9.2"></circle>
    <path d="M161.9 22.45 A9.2 9.2 0 1 1 150.1 22.45"></path>
    <path d="M156 13.5 L156 29"></path>
  </g>
  <rect class="pill" x="222" y="60" width="76" height="28" rx="14"></rect>
  <text class="labs" x="260" y="80.5" text-anchor="middle">labs</text>
</svg>

<style>
  .logo {
    display: block;
    overflow: visible;
  }

  text {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 40px;
    fill: var(--logo-text);
    transition: fill 0.45s;
  }

  .copper {
    fill: none;
    stroke: var(--copper);
    stroke-width: 3.8;
    stroke-linecap: round;
  }

  .pill {
    fill: var(--copper);
  }

  .labs {
    font-weight: 700;
    font-size: 22px;
    fill: #ffffff;
  }
</style>
