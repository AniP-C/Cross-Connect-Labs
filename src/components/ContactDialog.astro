---
import { booking, budgetChoices, contact, site, topics } from '../data/site';

// Used by the call dialog when online booking isn't available.
const callWhatsapp = contact.whatsapp ? `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.callMessage)}` : '';
const callEmail = contact.email ? `mailto:${contact.email}?subject=${encodeURIComponent('Call request')}&body=${encodeURIComponent(contact.callMessage)}` : '';
---

<dialog
  class="dialog"
  aria-labelledby="dlg-title"
  data-contact-dialog
  data-whatsapp={contact.whatsapp}
  data-email={contact.email}
  data-endpoint={contact.formEndpoint}
  data-key={contact.formAccessKey}
  data-reply={site.replyTime}
>
  <div class="sheet surface">
    <div class="head">
      <div>
        <h2 id="dlg-title">Tell us your idea</h2>
        <p>We’ll look at it and reply with the cost. No minimum budget.</p>
      </div>
      <button type="button" class="close" data-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <p class="quick" data-quick>
      <span class="led" aria-hidden="true"></span>
      <span>{booking.quick}</span>
      <button type="button" class="cable-link" data-book>{booking.quickCta} <span aria-hidden="true">→</span></button>
    </p>

    <form data-form novalidate>
      <fieldset>
        <legend>What do you need?</legend>
        <div class="chips">
          {
            topics.map((t) => (
              <label class="chip">
                <input type="radio" name="topic" value={t} checked={t === 'Not sure yet'} />
                <span>{t}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend>Your budget <span class="soft">(any amount is fine)</span></legend>
        <div class="chips">
          {
            budgetChoices.map((b) => (
              <label class="chip">
                <input type="radio" name="budget" value={b} checked={b === 'Not sure'} />
                <span>{b}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="fields">
        <label>
          Your name
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          WhatsApp or email
          <input type="text" name="contact" autocomplete="email" required />
        </label>
      </div>

      <label>
        A few lines about it <span class="soft">Optional</span>
        <textarea name="message" rows="3"></textarea>
      </label>

      <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="actions">
        <span class="note" data-note aria-live="polite">We reply within {site.replyTime} with the cost.</span>
        <button type="submit" class="send" data-send>send →</button>
      </div>

      <p class="talk">
        {booking.unsure}
        <button type="button" class="cable-link" data-book>{booking.talk} <span aria-hidden="true">→</span></button>
      </p>
    </form>

    <div class="done" data-done hidden>
      <span class="led big" aria-hidden="true"></span>
      <h3>Connected.</h3>
      <p data-done-text></p>
      <pre class="copy lcd" data-done-copy hidden></pre>
      <button type="button" class="back" data-close>back to the site</button>
    </div>
  </div>
</dialog>

<dialog class="dialog" aria-labelledby="book-title" data-book-dialog>
  <div class="sheet surface">
    <div class="head">
      <div>
        <h2 id="book-title">{booking.cta}</h2>
        <p>{booking.covered} A free {booking.minutes}-minute call on Google Meet. Tell us roughly what’s going on and we’ll work out the rest together.</p>
      </div>
      <button type="button" class="close" data-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <p class="status" data-book-status aria-live="polite">checking the line…</p>

    <div class="picker" data-book-picker hidden>
      <fieldset>
        <legend>Pick a day</legend>
        <div class="chips" data-book-days></div>
      </fieldset>
      <fieldset>
        <legend>Pick a time <span class="soft" data-book-zone></span></legend>
        <div class="chips" data-book-times></div>
      </fieldset>

      <form data-book-form novalidate>
        <div class="fields">
          <label>
            Your name
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Email <span class="soft">for the invite</span></span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label>
          <span>Anything we should know? <span class="soft">Optional</span></span>
          <textarea name="note" rows="2"></textarea>
        </label>
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="actions">
          <span class="note" data-book-note aria-live="polite">Pick a time first.</span>
          <button type="submit" class="send" data-book-send>book the call →</button>
        </div>
      </form>
    </div>

    <div class="fallback" data-book-fallback hidden>
      <p data-book-fallback-text>Online booking isn’t patched in yet. Message us and we’ll set up a time that suits you.</p>
      <div class="links">
        {callWhatsapp && <a class="cable-link" href={callWhatsapp} target="_blank" rel="noopener">WhatsApp {contact.whatsappDisplay} <span aria-hidden="true">→</span></a>}
        {callEmail && <a class="cable-link" href={callEmail}>Email {contact.emailDisplay} <span aria-hidden="true">→</span></a>}
      </div>
    </div>

    <div class="done" data-book-done hidden>
      <span class="led big" aria-hidden="true"></span>
      <h3>Booked.</h3>
      <p data-book-done-text></p>
      <button type="button" class="back" data-close>back to the site</button>
    </div>
  </div>
</dialog>

<style>
  .dialog {
    width: min(640px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }

  .dialog::backdrop {
    background: rgba(20, 24, 32, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .sheet {
    border-radius: 22px;
    padding: clamp(22px, 4vw, 34px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-height: calc(100vh - 32px);
    /* Phone browsers count the hidden address bar in 100vh, which cut off the send button. */
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  h2 {
    margin: 0 0 6px;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.04em;
  }

  .head p {
    margin: 0;
    color: var(--muted);
  }

  .close {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid var(--chip-line);
    background: var(--fill);
    color: var(--text);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .soft {
    font-weight: 400;
    font-size: 14px;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid var(--chip-line);
    background: var(--fill);
    color: var(--body);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .chip input:checked + span {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--on-copper);
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--copper);
    outline-offset: 2px;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 12px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 700;
  }

  input[type='text'],
  textarea {
    min-height: 48px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid var(--chip-line);
    background: var(--input-bg);
    color: var(--text);
    font-weight: 500;
    font-size: 16px;
  }

  textarea {
    padding: 12px 14px;
    resize: vertical;
  }

  [aria-invalid='true'] {
    border-color: var(--copper);
    box-shadow: 0 0 0 1px var(--copper);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--line-soft);
    padding-top: 18px;
  }

  .note {
    font-size: 14px;
    color: var(--muted);
  }

  .note.error {
    color: var(--copper-text);
  }

  .send {
    min-height: 52px;
    padding: 0 28px;
    border: 0;
    border-radius: 12px;
    background: var(--copper);
    color: var(--on-copper);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 15px;
  }

  .quick {
    margin: -6px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 12px;
    padding: 6px 16px;
    border-radius: 12px;
    border: 1px solid var(--copper-line);
    background: var(--copper-tint);
    color: var(--text);
    font-weight: 600;
    font-size: 15px;
  }

  .quick .cable-link {
    min-height: 40px;
  }

  .talk {
    margin: -6px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 12px;
    color: var(--body);
    font-size: 15px;
  }

  .send:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .done {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .led.big {
    width: 14px;
    height: 14px;
  }

  h3 {
    margin: 0;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.03em;
  }

  .done p {
    margin: 0;
    color: var(--body);
  }

  .copy {
    width: 100%;
    margin: 0;
    padding: 14px 16px;
    border-radius: 12px;
    white-space: pre-wrap;
    font-family: var(--mono);
    font-size: 13px;
    user-select: all;
  }

  /* Call booking. Day and time buttons are made by src/scripts/booking.ts, hence :global. */
  .status {
    margin: 0;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
  }

  .picker,
  .fallback {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .chips :global(.pick) {
    min-height: 40px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid var(--chip-line);
    background: var(--fill);
    color: var(--body);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 13px;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .chips :global(.pick[aria-pressed='true']) {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--on-copper);
  }

  .chips :global(.pick:focus-visible) {
    outline: 2px solid var(--copper);
    outline-offset: 2px;
  }

  input[type='email'] {
    min-height: 48px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid var(--chip-line);
    background: var(--input-bg);
    color: var(--text);
    font-weight: 500;
    font-size: 16px;
  }

  .fallback p {
    margin: 0;
    color: var(--body);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }

  .back {
    min-height: 48px;
    padding: 0 20px;
    border-radius: 10px;
    border: 1px solid var(--chip-line);
    background: var(--fill);
    color: var(--text);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 14px;
  }
</style>

<script>
  import '../scripts/booking';
  import { CONTACT_EVENT, bindContactButtons, type ContactPrefill } from '../scripts/contact-bus';

  bindContactButtons();

  const dialog = document.querySelector<HTMLDialogElement>('[data-contact-dialog]');

  if (dialog) {
    const cfg = dialog.dataset;
    const form = dialog.querySelector<HTMLFormElement>('[data-form]')!;
    const note = dialog.querySelector<HTMLElement>('[data-note]')!;
    const send = dialog.querySelector<HTMLButtonElement>('[data-send]')!;
    const done = dialog.querySelector<HTMLElement>('[data-done]')!;
    const doneText = dialog.querySelector<HTMLElement>('[data-done-text]')!;
    const doneCopy = dialog.querySelector<HTMLElement>('[data-done-copy]')!;
    const nameInput = form.elements.namedItem('name') as HTMLInputElement;
    const contactInput = form.elements.namedItem('contact') as HTMLInputElement;
    const messageInput = form.elements.namedItem('message') as HTMLTextAreaElement;
    const defaultNote = note.textContent ?? '';

    const setRadio = (name: string, value?: string) => {
      if (!value) return;
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`);
      if (input) input.checked = true;
    };
    const radioValue = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';

    function open(prefill: ContactPrefill) {
      form.hidden = false;
      done.hidden = true;
      note.textContent = defaultNote;
      note.classList.remove('error');
      setRadio('topic', prefill.topic ?? 'Not sure yet');
      if (prefill.budget) setRadio('budget', prefill.budget);
      if (prefill.message !== undefined) messageInput.value = prefill.message;
      if (!dialog!.open) dialog!.showModal();
      // Keep the sheet at the top so the heading and the call line show first, even on a phone.
      nameInput.focus({ preventScroll: true });
      dialog!.querySelector('.sheet')!.scrollTop = 0;
    }

    function finish(text: string, copy?: string) {
      form.hidden = true;
      done.hidden = false;
      doneText.textContent = text;
      doneCopy.hidden = !copy;
      doneCopy.textContent = copy ?? '';
    }

    function fail(text: string) {
      note.textContent = text;
      note.classList.add('error');
    }

    // The call buttons at the top and bottom: swap to the booking dialog, carrying what they've typed into its note.
    const toCall = () => {
      const note = document.querySelector<HTMLTextAreaElement>('[data-book-form] textarea[name="note"]');
      const said = [radioValue('topic'), messageInput.value.trim()].filter((t) => t && t !== 'Not sure yet').join('. ');
      if (note && !note.value.trim() && said) note.value = said;
      dialog.close();
    };
    dialog.querySelectorAll('[data-book]').forEach((b) => b.addEventListener('click', toCall));

    window.addEventListener(CONTACT_EVENT, (event) => open((event as CustomEvent<ContactPrefill>).detail ?? {}));

    dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = nameInput.value.trim();
      const reach = contactInput.value.trim();
      nameInput.setAttribute('aria-invalid', String(!name));
      contactInput.setAttribute('aria-invalid', String(reach.length < 6));
      if (!name || reach.length < 6) {
        fail('Add your name and a WhatsApp number or email.');
        (name ? contactInput : nameInput).focus();
        return;
      }

      const topic = radioValue('topic');
      const budget = radioValue('budget');
      const message = messageInput.value.trim();
      const reply = cfg.reply ?? 'a day';
      const text = [`Hi, I'm ${name}.`, `I need: ${topic}.`, `Budget: ${budget}.`, message, `Reach me on: ${reach}`].filter(Boolean).join('\n');

      if (cfg.endpoint) {
        send.disabled = true;
        try {
          const res = await fetch(cfg.endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: cfg.key || undefined,
              subject: `New enquiry: ${topic}`,
              from_name: 'Cross-Connect Labs website',
              name,
              contact: reach,
              topic,
              budget,
              message,
              botcheck: (form.elements.namedItem('botcheck') as HTMLInputElement).checked,
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          finish(`Thanks, ${name}. We’ll look at your idea and reply on ${reach} within ${reply} with the cost.`);
          form.reset();
        } catch {
          fail('That did not send. Please try again, or message us on WhatsApp.');
        } finally {
          send.disabled = false;
        }
      } else if (cfg.whatsapp) {
        window.open(`https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
        finish('WhatsApp should open with your message ready. Press send there and we’ll reply with the cost.');
      } else if (cfg.email) {
        window.location.href = `mailto:${cfg.email}?subject=${encodeURIComponent(`New enquiry: ${topic}`)}&body=${encodeURIComponent(text)}`;
        finish('Your email app should open with the message ready. Press send there and we’ll reply with the cost.');
      } else {
        finish('Contact details are not set up on this site yet, so nothing was sent. Here is your message, ready to copy:', text);
      }
    });
  }
</script>
