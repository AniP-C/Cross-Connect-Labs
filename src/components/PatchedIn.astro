---
import { patchedIn } from '../data/site';

// The strip is drawn twice so the loop has no seam; screen readers only get the first copy.
// A short list repeats inside each copy so one copy is always wider than the window.
const { groups } = patchedIn;
const count = groups.reduce((n, g) => n + g.items.length, 0);
const repeats = Array.from({ length: Math.max(1, Math.ceil(8 / count)) }, (_, i) => i);
const tagged = groups.length > 1;
---

<section class="patched" aria-labelledby="patched-title" data-patched>
  <div class="wrap">
    <div class="frame">
      <div class="row">
        <div class="lead">
          <h2 id="patched-title"><span class="led" aria-hidden="true"></span>{patchedIn.label}</h2>
        </div>
        <div class="window">
          <div class="track">
            {
              [0, 1].map((copy) => (
                <ul class="run" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {repeats.flatMap((r) =>
                    groups.map((g) => (
                      <>
                        {tagged && (
                          <li class:list={['tag', { echo: r > 0 }]} aria-hidden={r > 0 ? 'true' : undefined}>
                            {g.tag}
                          </li>
                        )}
                        {g.items.map((item) => (
                          <li class:list={['plate surface', { echo: r > 0 }]} aria-hidden={r > 0 ? 'true' : undefined}>
                            <span class="screw sm tl" aria-hidden="true" />
                            <span class="screw sm br" aria-hidden="true" />
                            <span class={g.live ? 'led' : 'led off'} aria-hidden="true" />
                            <span class="name">{item.name}</span>
                            <span class="note">{item.note}</span>
                          </li>
                        ))}
                      </>
                    )),
                  )}
                </ul>
              ))
            }
          </div>
        </div>
      </div>
      <p class="caption">{patchedIn.caption}</p>
    </div>
  </div>
</section>

<style>
  .frame {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 26px 0 24px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .lead {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h2 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }

  .window {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    /* Room for the plates' shadow; the fade masks the ends. The mask only uses alpha, so its colour is never drawn. */
    padding: 6px 0 14px;
    margin: -6px 0 -14px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .track {
    position: relative;
    z-index: 1;
    display: flex;
    width: max-content;
    animation: slide 52s linear infinite;
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  .run {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 0 14px 0 0;
    list-style: none;
  }

  /* Like a strip of label tape on the rack: copper text with a cable running into it. */
  .tag {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 10px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--copper-text);
    white-space: nowrap;
  }

  .tag::after {
    content: '';
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--copper-line);
  }

  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    min-width: 176px;
    height: 84px;
    padding: 0 30px;
    border-radius: 14px;
    white-space: nowrap;
  }

  .tl {
    top: 8px;
    left: 8px;
  }

  .br {
    right: 8px;
    bottom: 8px;
  }

  .plate .led {
    position: absolute;
    top: 9px;
    right: 9px;
    width: 7px;
    height: 7px;
  }

  .led.off {
    background: var(--led-off);
    box-shadow: none;
  }

  /* As a plate passes the middle of the strip it is "patched in": its light comes on and the
     faceplate picks up a copper edge, then both fade as it moves on. */
  .plate {
    transition: border-color 0.5s, box-shadow 0.5s;
  }

  .plate .led {
    transition: background 0.5s, box-shadow 0.5s;
  }

  .plate.lit {
    border-color: var(--copper-line);
    box-shadow: 0 0 0 3px var(--copper-tint);
  }

  .plate.lit .led {
    background: var(--led);
    box-shadow: 0 0 8px var(--led);
  }

  .name {
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .note {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  .caption {
    margin: 0;
    max-width: 52em;
    color: var(--body);
    font-size: 15px;
  }

  /* Phones: the label sits above the strip. */
  @media (max-width: 760px) {
    .row {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }

    .plate {
      min-width: 150px;
      height: 76px;
      padding: 0 24px;
    }

    .name {
      font-size: 18px;
    }
  }

  /* No motion: show every plate, wrapped, with no copy. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      width: auto;
      animation: none;
    }

    .run {
      flex-wrap: wrap;
      padding: 0;
    }

    .run[aria-hidden],
    .echo {
      display: none;
    }

    .window {
      -webkit-mask-image: none;
      mask-image: none;
    }

  }
</style>

<script>
  // Light each plate while it crosses the middle of the strip.
  const strip = document.querySelector<HTMLElement>('[data-patched] .window');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (strip && !still && 'IntersectionObserver' in window) {
    const seen = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('lit', e.isIntersecting)),
      { root: strip, rootMargin: '0px -44% 0px -44%' },
    );
    strip.querySelectorAll('.plate').forEach((plate) => seen.observe(plate));
  }
</script>
