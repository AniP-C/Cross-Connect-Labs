---
// The standalone mark: ring, cable and power button. `app` draws the navy app-icon square.
interface Props {
  size?: number;
  app?: boolean;
  label?: string;
}
const { size = 26, app = false, label } = Astro.props;
---

{
  app ? (
    <svg class="mark app" width={size} height={size} viewBox="0 0 40 40" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
      <rect width="40" height="40" rx="10" fill="#14202E" />
      <g fill="none" stroke-linecap="round" stroke-width="3">
        <circle cx="13" cy="17" r="5" stroke="#FFFFFF" />
        <path d="M30.21 13.17 A5 5 0 1 1 23.79 13.17" stroke="#C2541F" />
        <path d="M27 9 V16.5" stroke="#C2541F" />
        <path d="M13 22 C13 32 27 32 27 22" stroke="#C2541F" />
      </g>
    </svg>
  ) : (
    <svg class="mark" width={size} height={(size * 22) / 30} viewBox="0 0 30 22" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
      <g fill="none" stroke-width="2.2" stroke-linecap="round">
        <circle cx="6" cy="7" r="4.2" />
        <path d="M24.7 3.78 A4.2 4.2 0 1 1 19.3 3.78" />
        <path d="M22 0.5 V6.5" />
        <path d="M6 11.2 C6 19 22 19 22 11.2" />
      </g>
    </svg>
  )
}

<style>
  .mark:not(.app) g {
    stroke: var(--copper);
  }

  .mark {
    flex: none;
    display: block;
  }
</style>
