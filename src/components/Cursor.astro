<!-- A thin copper ring that trails the normal mouse pointer. Over anything clickable it widens
     and fills faintly; a click tightens it. The system pointer stays as it is. Mouse only, and
     off for reduced motion. Decorative only. -->
<div class="ring" aria-hidden="true" data-ring></div>

<style>
  .ring {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 200;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50%;
    border: 1.5px solid var(--copper-line);
    pointer-events: none;
    opacity: 0;
    transition: width 0.25s var(--ease), height 0.25s var(--ease), margin 0.25s var(--ease), background 0.25s, opacity 0.25s;
  }

  .ring.on {
    opacity: 1;
  }

  .ring.over {
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    background: var(--copper-tint);
  }

  .ring.down {
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
  }

  :global(html:has(dialog[open])) .ring {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ring {
      display: none;
    }
  }
</style>

<script>
  const ring = document.querySelector<HTMLElement>('[data-ring]');
  const mouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (ring && mouse && !calm) {
    const clickable = 'a, button, label, summary, select, [role="button"]';
    let x = 0;
    let y = 0;
    let rx = 0;
    let ry = 0;
    let frame = 0;

    // Ease the ring towards the pointer, and stop drawing once it has caught up.
    const step = () => {
      rx += (x - rx) * 0.25;
      ry += (y - ry) * 0.25;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      frame = Math.abs(x - rx) + Math.abs(y - ry) > 0.2 ? requestAnimationFrame(step) : 0;
    };

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      x = e.clientX;
      y = e.clientY;
      if (!ring.classList.contains('on')) {
        rx = x;
        ry = y;
        ring.classList.add('on');
      }
      ring.classList.toggle('over', !!(e.target as Element).closest?.(clickable));
      if (!frame) frame = requestAnimationFrame(step);
    });
    document.addEventListener('pointerdown', () => ring.classList.add('down'));
    document.addEventListener('pointerup', () => ring.classList.remove('down'));
    document.documentElement.addEventListener('mouseleave', () => ring.classList.remove('on'));
  }
</script>
