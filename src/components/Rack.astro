---
import { modules } from '../data/site';
---

<section id="services" class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2">The rack.</h2>
      <p>Eight modules, one person. Each one plugs into the others, so your website, bot and automations work together.</p>
    </div>
    <div class="grid">
      {
        modules.map((m) => (
          <article class="mod surface">
            <span class="screw sm" style="left: 9px; top: 9px" />
            <span class="screw sm" style="right: 9px; top: 9px" />
            <div class="top">
              <span>{m.code}</span>
              <span class="mod-led" aria-hidden="true" />
            </div>
            <h3>{m.name}</h3>
            <div class="time lcd">
              <span class="k">build time</span>
              <span class="v">{m.time}</span>
            </div>
            <p>{m.desc}</p>
            <div class="foot">
              <span class="jack-deco" aria-hidden="true" />
              <button type="button" class="cable-link" data-contact data-topic={m.topic}>
                patch in <span aria-hidden="true">→</span>
                <span class="sr-only">: ask about {m.name}</span>
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 14px;
  }

  .mod {
    position: relative;
    border-radius: 14px;
    padding: 26px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    transition: transform 0.35s var(--ease);
  }

  .mod:hover {
    transform: translateY(-5px);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .mod-led {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--led-off);
    transition: background 0.3s, box-shadow 0.3s;
  }

  .mod:hover .mod-led,
  .mod:focus-within .mod-led {
    background: var(--led);
    box-shadow: 0 0 12px var(--led);
  }

  h3 {
    margin: 0;
    font-weight: 700;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .time {
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--mono);
    box-shadow: inset 0 0 20px var(--lcd-inset);
  }

  .time .k {
    font-size: 11px;
    color: var(--lcd-muted);
  }

  .time .v {
    font-size: 15px;
    font-weight: 600;
  }

  p {
    margin: 0;
    color: var(--body);
    font-size: 15px;
    flex: 1;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--line-soft);
    padding-top: 14px;
  }

  .jack-deco {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(circle, #0b0b0c 0 36%, var(--jack-ring) 40% 58%, var(--jack-outer) 62% 100%);
  }
</style>
