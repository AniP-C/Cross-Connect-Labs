---
import { modules, phone, rack, servicePage } from '../data/site';

const page = (slug: string) => `/services/${slug}/`;
---

<section id="services" class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="title">
        <p class="label">{rack.label}</p>
        <h2 class="h2">{rack.heading}</h2>
      </div>
      <p><span class="long">{rack.intro}</span><span class="short">{phone.rackIntro}</span></p>
    </div>
    <div class="grid">
      {
        modules.map((m) => (
          <article class="mod surface">
            <span class="screw sm" style="left: 9px; top: 9px" />
            <span class="screw sm" style="right: 9px; top: 9px" />
            <div class="top">
              <span>{m.code}</span>
              <span class="mod-led" aria-hidden="true" />
            </div>
            <h3><a href={page(m.slug)}>{m.name}</a></h3>
            <div class="time lcd">
              <span class="k">build time</span>
              <span class="v">{m.time}</span>
            </div>
            <p>{m.desc}</p>
            <div class="foot">
              <a class="spec" href={page(m.slug)}>
                <span class="jack-deco" aria-hidden="true" />
                {servicePage.spec}
                <span class="sr-only">: {m.name}</span>
              </a>
              <button type="button" class="cable-link" data-contact data-topic={m.topic}>
                patch in <span aria-hidden="true">→</span>
                <span class="sr-only">: ask about {m.name}</span>
              </button>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Phones: the same modules as rows. Tap one to open what it does; one is open at a time. -->
    <div class="rows" data-rack-rows>
      {
        modules.map((m, i) => (
          <div class="row">
            <button type="button" class="row-head" data-row aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`mod-${i}`}>
              <span class="row-led" aria-hidden="true" />
              <span class="row-name">
                <span class="row-code">{m.code}</span>
                {m.name}
              </span>
              <span class="row-time lcd">{m.time}</span>
            </button>
            <div class="row-body" id={`mod-${i}`} hidden={i !== 0}>
              <p>{m.desc}</p>
              <div class="row-foot">
                <a class="spec" href={page(m.slug)}>
                  {servicePage.spec}
                  <span class="sr-only">: {m.name}</span>
                </a>
                <button type="button" class="cable-link" data-contact data-topic={m.topic}>
                  patch in <span aria-hidden="true">→</span>
                  <span class="sr-only">: ask about {m.name}</span>
                </button>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .title {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Plain words above the equipment name, so it reads as "services" at a glance. */
  .section-head .label {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--copper-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 14px;
  }

  .mod {
    position: relative;
    border-radius: 14px;
    padding: 26px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    transition: transform 0.35s var(--ease);
  }

  .mod:hover {
    transform: translateY(-5px);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .mod-led {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--led-off);
    transition: background 0.3s, box-shadow 0.3s;
  }

  .mod:hover .mod-led,
  .mod:focus-within .mod-led {
    background: var(--led);
    box-shadow: 0 0 12px var(--led);
  }

  h3 {
    margin: 0;
    font-weight: 700;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .time {
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--mono);
    box-shadow: inset 0 0 20px var(--lcd-inset);
  }

  .time .k {
    font-size: 11px;
    color: var(--lcd-muted);
  }

  .time .v {
    font-size: 15px;
    font-weight: 600;
  }

  p {
    margin: 0;
    color: var(--body);
    font-size: 15px;
    flex: 1;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--line-soft);
    padding-top: 14px;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--copper-text);
  }

  /* Link to the module's own page. Quieter than "patch in", so the card keeps one main action. */
  .spec {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .spec:hover {
    color: var(--copper-text);
  }

  .row-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .jack-deco {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--socket) 0 36%, var(--jack-ring) 40% 58%, var(--jack-outer) 62% 100%);
  }

  .rows,
  .short {
    display: none;
  }

  @media (max-width: 760px) {
    .grid,
    .long {
      display: none;
    }

    .short {
      display: inline;
    }

    .rows {
      display: block;
      border-top: 1px solid var(--line);
    }
  }

  .row {
    border-bottom: 1px solid var(--line);
  }

  .row-head {
    width: 100%;
    min-height: 64px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 4px;
    border: 0;
    background: transparent;
    color: var(--text);
    text-align: left;
    transition: background 0.25s;
  }

  .row-head[aria-expanded='true'] {
    background: var(--sel-bg);
  }

  .row-led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--led-off);
    transition: background 0.2s, box-shadow 0.2s;
  }

  .row-head[aria-expanded='true'] .row-led {
    background: var(--led);
    box-shadow: 0 0 8px var(--led);
  }

  .row-name {
    display: flex;
    flex-direction: column;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.25;
  }

  .row-code {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .row-head[aria-expanded='true'] .row-code {
    color: var(--copper-text);
  }

  .row-time {
    padding: 5px 9px;
    border-radius: 7px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .row-body {
    padding: 2px 4px 12px 24px;
  }
</style>

<script>
  const rows = document.querySelector<HTMLElement>('[data-rack-rows]');
  if (rows) {
    const heads = Array.from(rows.querySelectorAll<HTMLButtonElement>('[data-row]'));
    heads.forEach((head) =>
      head.addEventListener('click', () => {
        const open = head.getAttribute('aria-expanded') !== 'true';
        heads.forEach((h) => {
          const on = h === head && open;
          h.setAttribute('aria-expanded', String(on));
          const body = document.getElementById(h.getAttribute('aria-controls') ?? '');
          if (body) body.hidden = !on;
        });
        // Closing a longer row above can pull this one off the top of the screen; bring it back.
        const top = head.getBoundingClientRect().top;
        if (open && top < 64) window.scrollBy({ top: top - 72 });
      }),
    );
  }
</script>
