---
import Logo from './Logo.astro';
import { booking, nav, phone, site } from '../data/site';

const sheetLinks = [...nav, phone.contact];
---

<header class="site-header" data-header>
  <div class="wrap inner">
    <a href="#top" class="home" aria-label="Cross-Connect Labs home"><Logo height={42} /></a>
    <nav aria-label="Main" class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="right">
      <span class="status"><span class="led"></span>online · replies in {site.replyShort}</span>
      <button type="button" class="hurry" data-book>
        <span class="ask">{booking.hurry}</span>
        <span class="go">{booking.hurryCta} <span aria-hidden="true">→</span></span>
      </button>
      <button class="mode" type="button" data-theme-toggle aria-pressed="false" aria-label="Night mode">
        <span class="track" aria-hidden="true">
          <span class="knob">
            <svg class="only-day" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="only-night" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
            </svg>
          </span>
        </span>
        <span class="label"><span class="only-day">DAY</span><span class="only-night">NIGHT</span></span>
      </button>
      <button type="button" class="menu-btn" data-menu aria-expanded="false" aria-controls="phone-menu">
        <span class="rails" aria-hidden="true"><i></i><i></i><i></i></span>
        {phone.menu}
      </button>
    </div>
  </div>
  <nav id="phone-menu" class="sheet" aria-label="Sections" data-sheet hidden>
    <p class="sheet-head">{phone.menuHeading}</p>
    {
      sheetLinks.map((item, i) => (
        <a class="jack" href={item.href}>
          <span class="code">0{i + 1}</span>
          {item.label}
          <span class="hole" aria-hidden="true" />
        </a>
      ))
    }
  </nav>
</header>

<!-- Phones: the call bar at the bottom, shown once the hero has scrolled away. It sits outside the
     header because the header's blur and slide would trap a fixed element inside it. -->
<div class="dock" data-dock hidden>
  <button type="button" class="dock-call" data-book>{booking.hurryCta}</button>
  <button type="button" class="dock-send" data-contact><span class="led" aria-hidden="true"></span>{phone.send}</button>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .home {
    display: block;
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
  }

  .nav a {
    color: var(--text);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s;
  }

  .nav a:hover {
    opacity: 1;
  }

  .right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .hurry {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--copper-line);
    background: var(--copper-tint);
    font-family: var(--mono);
    font-size: 12px;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s;
  }

  .hurry:hover {
    border-color: var(--copper);
  }

  .ask {
    color: var(--body);
  }

  .go {
    color: var(--copper-text);
    font-weight: 700;
  }

  /* Make room for the call button before the header wraps. */
  @media (max-width: 1180px) {
    .status {
      display: none;
    }
  }

  .mode {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 12px 0 6px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel-hi);
    box-shadow: inset 0 1px 0 var(--hl);
    color: var(--text);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .track {
    position: relative;
    width: 50px;
    height: 28px;
    border-radius: 999px;
    background: var(--sw-off);
    box-shadow: inset 0 1px 4px var(--track-inset);
  }

  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #ffffff;
    color: var(--copper-text);
    box-shadow: 0 1px 4px var(--knob-shadow);
    transition: transform 0.35s var(--ease), background 0.3s, color 0.3s;
  }

  :global(:root[data-theme='dark']) .knob {
    transform: translateX(22px);
    background: var(--copper);
    color: #1c1c1e;
  }

  .menu-btn,
  .dock {
    display: none;
  }

  /* Phones: one row (logo, switch, menu). The menu opens a sheet, the call button moves to the
     bottom bar, and the header slides away while you scroll down. */
  @media (max-width: 760px) {
    .site-header {
      transition: transform 0.3s var(--ease);
    }

    .site-header.away {
      transform: translateY(-100%);
    }

    .inner {
      flex-wrap: nowrap;
      gap: 8px;
      padding-top: 6px;
      padding-bottom: 6px;
    }

    .home {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .home :global(svg) {
      height: 32px;
      width: auto;
    }

    .nav,
    .status,
    .hurry,
    .mode .label {
      display: none;
    }

    .right {
      flex-wrap: nowrap;
      gap: 8px;
    }

    .mode {
      min-height: 44px;
      padding: 0 7px;
    }

    .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--panel-hi);
      box-shadow: inset 0 1px 0 var(--hl);
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 600;
    }

    .menu-btn[aria-expanded='true'] {
      border-color: var(--copper-line);
      background: var(--copper-tint);
    }

    .rails {
      display: grid;
      gap: 3px;
    }

    .rails i {
      display: block;
      width: 14px;
      height: 2px;
      border-radius: 2px;
      background: var(--copper);
    }

    .rails i:nth-child(2) {
      width: 9px;
    }

    .sheet {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: calc(100dvh - 60px);
      overflow-y: auto;
      padding: 14px var(--gutter) 18px;
      background: var(--panel-hi);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 30px 60px -20px var(--shadow);
    }

    .sheet-head {
      margin: 0 0 4px;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--copper-text);
    }

    .jack {
      display: grid;
      grid-template-columns: 36px 1fr auto;
      align-items: center;
      min-height: 52px;
      padding: 0 14px;
      border-radius: 12px;
      border: 1px solid var(--line);
      background: var(--panel);
      color: var(--text);
      font-family: var(--mono);
      font-size: 16px;
      font-weight: 600;
      text-decoration: none;
    }

    .jack .code {
      font-size: 12px;
      font-weight: 400;
      color: var(--muted);
    }

    .hole {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--socket);
      box-shadow: 0 0 0 4px var(--jack-outer), 0 0 0 5px var(--jack-ring);
    }

    .jack:active .hole {
      box-shadow: 0 0 0 4px var(--copper), 0 0 0 5px var(--copper-line);
    }

    .dock {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 25;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 8px;
      border-radius: 18px;
      border: 1px solid var(--line);
      background: var(--header-bg);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 20px 40px -20px var(--shadow);
      animation: dock-rise 0.35s var(--ease);
    }

    .dock button {
      min-height: 48px;
      border-radius: 12px;
      font-family: var(--mono);
      font-size: 14px;
      font-weight: 700;
    }

    .dock-call {
      border: 1px solid var(--copper-line);
      background: var(--copper-tint);
      color: var(--copper-text);
    }

    .dock-send {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 0;
      background: var(--copper);
      color: var(--on-copper);
    }

    .dock-send .led {
      background: var(--on-copper);
      box-shadow: none;
    }
  }

  @keyframes dock-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const meta = document.querySelector<HTMLMetaElement>('meta[data-theme-color]');

  function apply(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
    meta?.setAttribute('content', theme === 'dark' ? '#18181B' : '#EEEFF1');
  }

  apply(document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    apply(next);
    try {
      localStorage.setItem('cc-theme', next);
    } catch {
      // Storage can be blocked; the toggle still works for this visit.
    }
  });

  // Phones: menu sheet, a header that slides away on the way down, and the bottom call bar.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = header?.querySelector<HTMLButtonElement>('[data-menu]');
  const sheet = header?.querySelector<HTMLElement>('[data-sheet]');
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const isPhone = window.matchMedia('(max-width: 760px)');

  if (header && menu && sheet && dock) {
    const setMenu = (open: boolean) => {
      sheet.hidden = !open;
      menu.setAttribute('aria-expanded', String(open));
      if (open) {
        header.classList.remove('away');
        sheet.querySelector<HTMLElement>('a')?.focus();
      }
    };

    menu.addEventListener('click', () => setMenu(sheet.hidden));
    sheet.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || sheet.hidden) return;
      setMenu(false);
      menu.focus();
    });
    document.addEventListener('click', (e) => {
      if (!sheet.hidden && !header.contains(e.target as Node)) setMenu(false);
    });

    let lastY = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        if (Math.abs(y - lastY) < 6) return;
        const keep = !isPhone.matches || !sheet.hidden || header.contains(document.activeElement);
        header.classList.toggle('away', !keep && y > lastY && y > 120);
        lastY = y;
      },
      { passive: true },
    );

    // The bar shows once the hero is fully gone, and steps aside at the contact section, which has the same buttons.
    let pastHero = false;
    let atContact = false;
    const update = () => {
      dock.hidden = !(isPhone.matches && pastHero && !atContact);
    };
    const hero = document.getElementById('top');
    const contactSection = document.getElementById('contact');
    if (hero) {
      new IntersectionObserver(([e]) => {
        pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
        update();
      }).observe(hero);
    }
    if (contactSection) {
      new IntersectionObserver(([e]) => {
        atContact = e.isIntersecting;
        update();
      }).observe(contactSection);
    }
    isPhone.addEventListener('change', () => {
      if (!isPhone.matches) {
        setMenu(false);
        header.classList.remove('away');
      }
      update();
    });
  }
</script>
