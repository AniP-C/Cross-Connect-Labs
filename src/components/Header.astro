---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
---

<header class="site-header">
  <div class="wrap inner">
    <a href="#top" class="home" aria-label="Cross-Connect Labs home"><Logo height={42} /></a>
    <nav aria-label="Main" class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="right">
      <span class="status"><span class="led"></span>online · replies within {site.replyTime}</span>
      <button class="mode" type="button" data-theme-toggle aria-pressed="false" aria-label="Night mode">
        <span class="track" aria-hidden="true">
          <span class="knob">
            <svg class="only-day" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="only-night" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
            </svg>
          </span>
        </span>
        <span class="label"><span class="only-day">DAY</span><span class="only-night">NIGHT</span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 12px;
    padding-bottom: 12px;
  }

  .home {
    display: block;
    text-decoration: none;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
  }

  .nav a {
    color: var(--text);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s;
  }

  .nav a:hover {
    opacity: 1;
  }

  .right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .mode {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 12px 0 6px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel-hi);
    box-shadow: inset 0 1px 0 var(--hl);
    color: var(--text);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .track {
    position: relative;
    width: 50px;
    height: 28px;
    border-radius: 999px;
    background: var(--sw-off);
    box-shadow: inset 0 1px 4px var(--track-inset);
  }

  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #ffffff;
    color: var(--copper-text);
    box-shadow: 0 1px 4px var(--knob-shadow);
    transition: transform 0.35s var(--ease), background 0.3s, color 0.3s;
  }

  :global(:root[data-theme='dark']) .knob {
    transform: translateX(22px);
    background: var(--copper);
    color: #1c1c1e;
  }

  @media (max-width: 760px) {
    .inner {
      gap: 8px 16px;
      padding-top: 10px;
      padding-bottom: 8px;
    }

    .nav {
      order: 3;
      flex: 1 1 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 20px;
    }

    .nav a {
      flex: none;
      padding: 6px 0;
    }

    .status {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const meta = document.querySelector<HTMLMetaElement>('meta[data-theme-color]');

  function apply(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
    meta?.setAttribute('content', theme === 'dark' ? '#18181B' : '#EEEFF1');
  }

  apply(document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    apply(next);
    try {
      localStorage.setItem('cc-theme', next);
    } catch {
      // Storage can be blocked; the toggle still works for this visit.
    }
  });
</script>
