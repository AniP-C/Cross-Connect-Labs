---
import { steps } from '../data/site';
---

<section class="section" aria-labelledby="signal-title">
  <div class="wrap">
    <h2 id="signal-title" class="h2 head">Signal path.</h2>
    <div class="path">
      <div class="line" aria-hidden="true"><span class="dot"></span></div>
      <ol>
        {
          steps.map((s, i) => (
            <li>
              <span class:list={['num', { last: i === steps.length - 1 }]} aria-hidden="true">
                {i + 1}
              </span>
              <b>{s.title}</b>
              <span class="text">{s.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: 40px;
  }

  .path {
    position: relative;
  }

  .line {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 22px;
    height: 4px;
    border-radius: 2px;
    background: var(--copper-line);
  }

  .dot {
    position: absolute;
    top: -4px;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--led);
    box-shadow: 0 0 16px var(--led);
    animation: cc-run 4s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  @keyframes cc-run {
    0% {
      left: 0;
      opacity: 0;
    }
    8%,
    92% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 18px;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--bg);
    border: 2px solid var(--copper);
    font-family: var(--mono);
    font-weight: 600;
    color: var(--copper-text);
  }

  .num.last {
    background: var(--copper);
    color: var(--on-copper);
    box-shadow: 0 0 20px var(--copper-glow);
  }

  b {
    font-size: 20px;
    color: var(--text);
  }

  .text {
    color: var(--muted);
  }

  /* Phones: number on the left, title and text beside it. */
  @media (max-width: 760px) {
    .head {
      margin-bottom: 28px;
    }

    .line {
      display: none;
    }

    li {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 4px 16px;
    }

    .num {
      grid-row: span 2;
    }

    b {
      font-size: 18px;
      align-self: end;
    }
  }
</style>
