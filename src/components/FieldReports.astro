---
import { reports } from '../data/site';
---

<section class="section" aria-labelledby="reports-title">
  <div class="wrap">
    <h2 id="reports-title" class="h2 head">Field reports.</h2>
    <div class="grid">
      {
        reports.map((r) => (
          <article class="surface">
            <span class="tag"><span class="led" aria-hidden="true" />{r.tag}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 14px;
  }

  article {
    padding: 24px 26px 26px;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .tag .led {
    width: 6px;
    height: 6px;
  }

  h3 {
    margin: 0;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  p {
    margin: 0;
    font-size: 15px;
    color: var(--body);
  }
</style>
