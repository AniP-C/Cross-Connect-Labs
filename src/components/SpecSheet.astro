---
import { spec } from '../data/site';
---

<section id="about" class="section">
  <div class="wrap layout">
    <div class="photo surface" role="img" aria-label="Photo placeholder">
      <!-- Replace with: <img src="/me.jpg" alt="[Your name] at work" /> -->
      [Your photo]
    </div>
    <div class="copy">
      <h2 class="h2">Spec sheet.</h2>
      <p>Cross-Connect Labs is just me. You talk directly to the person who builds your project, from the first message to launch and after.</p>
      <dl>
        {
          spec.map((row) => (
            <>
              <dt>{row.key}</dt>
              <dd class:list={{ strong: row.strong }}>{row.value}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 56px;
    align-items: stretch;
  }

  .photo {
    flex: 1 1 320px;
    max-width: 460px;
    min-height: 420px;
    border-radius: 22px;
    display: grid;
    place-items: center;
    color: var(--muted);
    overflow: hidden;
  }

  .copy {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  p {
    margin: 0;
    font-size: 18px;
    color: var(--body);
    max-width: 32em;
  }

  dl {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--panel-hi);
    display: grid;
    grid-template-columns: minmax(8em, 34%) minmax(0, 1fr);
    font-size: 15px;
  }

  dt,
  dd {
    padding: 13px 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  dt:last-of-type,
  dd:last-of-type {
    border-bottom: 0;
  }

  dt {
    background: var(--fill);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  dd {
    margin: 0;
    color: var(--body);
  }

  dd.strong {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .photo {
      min-height: 320px;
    }

    dl {
      grid-template-columns: 1fr;
    }

    dt {
      border-bottom: 0;
      padding-bottom: 4px;
    }

    dd {
      padding-top: 4px;
    }
  }
</style>
