---
import IconMark from './IconMark.astro';
import { JACK_Y, builds, problems } from '../data/site';

// Cable from problem `a` (left jack) to build `b` (right jack), in the 640 × 400 drawing.
function cablePath(a: number, b: number) {
  const y1 = JACK_Y[a];
  const y2 = JACK_Y[b];
  const sag = 70 + Math.abs(y1 - y2) * 0.25;
  return `M200 ${y1} C270 ${y1 + sag} 370 ${y2 + sag} 440 ${y2}`;
}
const d = cablePath(0, 0);
const top = (i: number) => `${JACK_Y[i] / 4}%`;
---

<div class="patchbay-wrap" data-patchbay data-jack-y={JACK_Y.join(',')}>
  <div class="panel surface">
    <span class="screw" style="left: 12px; top: 12px"></span>
    <span class="screw" style="right: 12px; top: 12px"></span>
    <span class="screw" style="left: 12px; bottom: 12px"></span>
    <span class="screw" style="right: 12px; bottom: 12px"></span>

    <div class="pattern" aria-hidden="true">
      <svg width="100%" height="100%">
        <defs>
          <pattern id="cc-circuit" width="180" height="180" patternUnits="userSpaceOnUse">
            <g class="trace">
              <path d="M0 30 H56 L76 50 H124 L144 30 H180"></path>
              <path d="M30 0 V14"></path>
              <path d="M30 180 V140 L50 120 H92"></path>
              <path d="M150 0 V10"></path>
              <path d="M150 180 V150 L130 130 V100"></path>
              <path d="M0 100 H18 L34 84"></path>
              <path d="M180 100 H166 L156 110 V160"></path>
              <path d="M76 50 V78 L92 94"></path>
            </g>
            <g class="pad">
              <circle cx="30" cy="18" r="4"></circle>
              <circle cx="96" cy="120" r="4"></circle>
              <circle cx="150" cy="14" r="4"></circle>
              <circle cx="130" cy="96" r="4"></circle>
              <circle cx="37" cy="81" r="4"></circle>
              <circle cx="95" cy="97" r="4"></circle>
            </g>
            <g class="via">
              <circle cx="100" cy="160" r="2.2"></circle>
              <circle cx="12" cy="150" r="2.2"></circle>
              <circle cx="156" cy="164" r="2.2"></circle>
            </g>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#cc-circuit)"></rect>
      </svg>
    </div>

    <span class="col-title left" aria-hidden="true">YOUR PROBLEM</span>
    <span class="col-title right" aria-hidden="true">WHAT WE BUILD</span>

    <svg class="cables" viewBox="0 0 640 400" aria-hidden="true">
      <path class="cable outline" data-cable d={d}></path>
      <path class="cable core" data-cable d={d}></path>
      <path class="cable shine" data-cable d={d} transform="translate(0 -1.6)"></path>
      <path class="cable pulse" data-cable d={d} pathLength="400"></path>
      <circle class="plug" data-plug="from" cx="200" cy={JACK_Y[0]} r="9"></circle>
      <circle class="plug" data-plug="to" cx="440" cy={JACK_Y[0]} r="9"></circle>
    </svg>

    <div role="group" aria-label="Your problem">
      {
        problems.map((label, i) => (
          <button type="button" class="jack left" data-side="from" data-index={i} aria-pressed={i === 0 ? 'true' : 'false'} style={`--y: ${top(i)}`}>
            <span class="jack-label">{label}</span>
            <span class="hole" aria-hidden="true"></span>
          </button>
        ))
      }
    </div>
    <div role="group" aria-label="What we build">
      {
        builds.map((b, i) => (
          <button type="button" class="jack right" data-side="to" data-index={i} data-topic={b.topic} data-time={b.time} aria-pressed={i === 0 ? 'true' : 'false'} style={`--y: ${top(i)}`}>
            <span class="hole" aria-hidden="true"></span>
            <span class="jack-label">{b.label}</span>
          </button>
        ))
      }
    </div>

    <div class="strip" aria-hidden="true">
      <span class="strip-name"><IconMark size={26} />CC-01 · CROSS-CONNECT PATCH BAY</span>
      <span class="strip-pwr">PWR <span class="led"></span></span>
    </div>
  </div>

  <div class="controls">
    <div class="readout lcd" aria-live="polite">
      <div><span class="k">problem </span><span data-readout="problem">{problems[0].toLowerCase()}</span></div>
      <div><span class="k">fix ··· </span><span data-readout="build">{builds[0].label.toLowerCase()}</span></div>
      <div><span class="k">time ·· </span><span data-readout="time">{builds[0].time}</span> · any budget<span class="cursor" aria-hidden="true">▍</span></div>
    </div>
    <button type="button" class="flip surface" data-flip aria-pressed="false" aria-label="Send this connection to us">
      <span class="flip-track" aria-hidden="true"><span class="flip-knob"></span></span>
      <span class="flip-label" data-flip-label>FLIP TO SEND</span>
    </button>
  </div>
</div>

<style>
  .patchbay-wrap {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .panel {
    position: relative;
    width: 100%;
    aspect-ratio: 640 / 400;
    border-radius: 18px;
  }

  .pattern {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 72% 78% at 50% 55%, #000 30%, transparent 92%);
    mask-image: radial-gradient(ellipse 72% 78% at 50% 55%, #000 30%, transparent 92%);
  }

  .pattern svg {
    display: block;
  }

  .trace {
    fill: none;
    stroke: var(--trace);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pad {
    fill: none;
    stroke: var(--pad);
    stroke-width: 1.5;
  }

  .via {
    fill: var(--pad);
  }

  .col-title {
    position: absolute;
    top: 12%;
    font-family: var(--mono);
    font-size: clamp(9px, 1.2vw, 11px);
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .col-title.left {
    right: calc(68.75% - 15px);
  }

  .col-title.right {
    left: calc(68.75% - 15px);
  }

  .cables {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
  }

  .cable {
    stroke-linecap: round;
    transition: d 0.5s var(--ease);
  }

  .outline {
    stroke: var(--cable-out);
    stroke-width: 10;
  }

  .core {
    stroke: var(--copper);
    stroke-width: 6.5;
  }

  .shine {
    stroke: var(--cable-hi);
    stroke-width: 1.4;
  }

  .pulse {
    stroke: var(--pulse);
    stroke-width: 3;
    stroke-dasharray: 16 384;
    filter: drop-shadow(0 0 6px var(--led));
    animation: cc-flow 2.6s linear infinite;
  }

  @keyframes cc-flow {
    to {
      stroke-dashoffset: -400;
    }
  }

  .plug {
    fill: var(--copper);
    stroke: var(--cable-out);
    stroke-width: 2.5;
    transition: cy 0.5s var(--ease);
  }

  .jack {
    position: absolute;
    top: var(--y);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px;
    border: 0;
    background: none;
    color: var(--muted);
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(10px, 1.45vw, 14px);
    line-height: 1.2;
    transition: color 0.2s;
  }

  .jack.left {
    right: calc(68.75% - 15px);
    padding-right: 0;
    text-align: right;
  }

  .jack.right {
    left: calc(68.75% - 15px);
    padding-left: 0;
    text-align: left;
  }

  .jack-label {
    max-width: 10em;
  }

  .hole {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: radial-gradient(circle, #0b0b0c 0 36%, var(--jack-ring) 39% 60%, var(--jack-outer) 63% 100%);
    box-shadow: inset 0 1px 1px var(--hl);
    transition: transform 0.2s, box-shadow 0.25s;
  }

  .jack:hover .hole {
    transform: scale(1.08);
  }

  .jack[aria-pressed='true'] {
    color: var(--text);
  }

  .jack[aria-pressed='true'] .hole {
    background: radial-gradient(circle, #0b0b0c 0 36%, var(--copper) 39% 60%, var(--jack-outer) 63% 100%);
    box-shadow: 0 0 0 2px rgba(194, 84, 31, 0.35), 0 0 16px rgba(194, 84, 31, 0.6);
  }

  .strip {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 3.5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: clamp(8px, 1.1vw, 10px);
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .strip-name,
  .strip-pwr {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .strip .led {
    width: 7px;
    height: 7px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: stretch;
  }

  .readout {
    flex: 1 1 300px;
    min-width: 0;
    border-radius: 14px;
    border: 1px solid var(--line-soft);
    padding: 14px 18px;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.75;
  }

  .readout .k {
    color: var(--lcd-muted);
  }

  .cursor {
    animation: cc-blink 1.1s steps(1) infinite;
  }

  .flip {
    flex: 0 0 150px;
    min-height: 96px;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--text);
    transition: transform 0.2s;
  }

  .flip:hover {
    transform: translateY(-2px);
  }

  .flip-track {
    position: relative;
    width: 72px;
    height: 36px;
    border-radius: 999px;
    background: var(--sw-off);
    box-shadow: inset 0 2px 6px var(--track-inset);
    transition: background 0.3s;
  }

  .flip-knob {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--sw-knob-off);
    box-shadow: 0 2px 6px var(--knob-shadow);
    transition: transform 0.35s var(--ease), background 0.3s;
  }

  .flip[aria-pressed='true'] .flip-track {
    background: var(--copper);
  }

  .flip[aria-pressed='true'] .flip-knob {
    transform: translateX(36px);
    background: #ffffff;
  }

  .flip-label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  @media (max-width: 480px) {
    .hole {
      width: 24px;
      height: 24px;
    }

    .jack.left {
      right: calc(68.75% - 12px);
    }

    .jack.right {
      left: calc(68.75% - 12px);
    }

    .jack {
      gap: 6px;
    }

    .strip-name {
      font-size: 0;
    }

    .flip {
      flex-basis: 100%;
      min-height: 72px;
      flex-direction: row;
    }
  }
</style>

<script>
  import { openContact } from '../scripts/contact-bus';

  const root = document.querySelector<HTMLElement>('[data-patchbay]');

  if (root) {
    const jackY = (root.dataset.jackY ?? '').split(',').map(Number);
    const cables = root.querySelectorAll<SVGPathElement>('[data-cable]');
    const plugFrom = root.querySelector<SVGCircleElement>('[data-plug="from"]');
    const plugTo = root.querySelector<SVGCircleElement>('[data-plug="to"]');
    const fromJacks = Array.from(root.querySelectorAll<HTMLButtonElement>('.jack[data-side="from"]'));
    const toJacks = Array.from(root.querySelectorAll<HTMLButtonElement>('.jack[data-side="to"]'));
    const out = {
      problem: root.querySelector<HTMLElement>('[data-readout="problem"]'),
      build: root.querySelector<HTMLElement>('[data-readout="build"]'),
      time: root.querySelector<HTMLElement>('[data-readout="time"]'),
    };
    const flip = root.querySelector<HTMLButtonElement>('[data-flip]');
    const flipLabel = root.querySelector<HTMLElement>('[data-flip-label]');
    let from = 0;
    let to = 0;
    let timer: number | undefined;

    const label = (b: HTMLButtonElement) => b.querySelector('.jack-label')?.textContent?.trim() ?? '';

    function render() {
      const y1 = jackY[from];
      const y2 = jackY[to];
      const sag = 70 + Math.abs(y1 - y2) * 0.25;
      const d = `M200 ${y1} C270 ${y1 + sag} 370 ${y2 + sag} 440 ${y2}`;
      cables.forEach((p) => p.setAttribute('d', d));
      plugFrom?.setAttribute('cy', String(y1));
      plugTo?.setAttribute('cy', String(y2));
      fromJacks.forEach((b, i) => b.setAttribute('aria-pressed', String(i === from)));
      toJacks.forEach((b, i) => b.setAttribute('aria-pressed', String(i === to)));
      if (out.problem) out.problem.textContent = label(fromJacks[from]).toLowerCase();
      if (out.build) out.build.textContent = label(toJacks[to]).toLowerCase();
      if (out.time) out.time.textContent = toJacks[to].dataset.time ?? '';
    }

    fromJacks.forEach((b, i) =>
      b.addEventListener('click', () => {
        from = i;
        render();
      }),
    );
    toJacks.forEach((b, i) =>
      b.addEventListener('click', () => {
        to = i;
        render();
      }),
    );

    flip?.addEventListener('click', () => {
      if (flip.getAttribute('aria-pressed') === 'true') return;
      flip.setAttribute('aria-pressed', 'true');
      if (flipLabel) flipLabel.textContent = 'SENDING…';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        const problem = label(fromJacks[from]);
        const build = toJacks[to];
        openContact({
          topic: build.dataset.topic,
          message: `Problem: ${problem}. I think I need: ${label(build)}.`,
        });
        flip.setAttribute('aria-pressed', 'false');
        if (flipLabel) flipLabel.textContent = 'FLIP TO SEND';
      }, 650);
    });
  }
</script>
