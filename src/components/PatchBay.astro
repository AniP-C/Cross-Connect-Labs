---
import IconMark from './IconMark.astro';
import { patchHeads, patchUnsure, patches } from '../data/site';

const first = patches[0];
---

<!-- Fault finder: pick what's going wrong on the left; a short cable runs into the card that shows the fix. -->
<div class="patchbay surface" data-patchbay>
  <span class="screw" style="left: 12px; top: 12px"></span>
  <span class="screw" style="right: 12px; top: 12px"></span>
  <span class="screw" style="left: 12px; bottom: 12px"></span>
  <span class="screw" style="right: 12px; bottom: 12px"></span>

  <div class="pattern" aria-hidden="true">
    <svg width="100%" height="100%">
      <defs>
        <pattern id="cc-circuit" width="180" height="180" patternUnits="userSpaceOnUse">
          <g class="trace">
            <path d="M0 30 H56 L76 50 H124 L144 30 H180"></path>
            <path d="M30 0 V14"></path>
            <path d="M30 180 V140 L50 120 H92"></path>
            <path d="M150 0 V10"></path>
            <path d="M150 180 V150 L130 130 V100"></path>
            <path d="M0 100 H18 L34 84"></path>
            <path d="M180 100 H166 L156 110 V160"></path>
            <path d="M76 50 V78 L92 94"></path>
          </g>
          <g class="pad">
            <circle cx="30" cy="18" r="4"></circle>
            <circle cx="96" cy="120" r="4"></circle>
            <circle cx="150" cy="14" r="4"></circle>
            <circle cx="130" cy="96" r="4"></circle>
            <circle cx="37" cy="81" r="4"></circle>
            <circle cx="95" cy="97" r="4"></circle>
          </g>
          <g class="via">
            <circle cx="100" cy="160" r="2.2"></circle>
            <circle cx="12" cy="150" r="2.2"></circle>
            <circle cx="156" cy="164" r="2.2"></circle>
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cc-circuit)"></rect>
    </svg>
  </div>

  <div class="body">
    <div class="keys" role="group" aria-labelledby="pb-problem">
      <span class="ask" id="pb-problem"><span class="led" aria-hidden="true"></span>{patchHeads.problem}</span>
      {
        patches.map((p, i) => (
          <button type="button" class="key" data-index={i} data-fix={p.fix} data-topic={p.topic} data-time={p.time} data-does={p.does} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="dot" aria-hidden="true" />
            <span class="problem">{p.problem}</span>
          </button>
        ))
      }
      <button type="button" class="key unsure" data-index={patches.length} data-fix={patchUnsure.fix} data-time={patchUnsure.time} data-tail={patchUnsure.tail} data-does={patchUnsure.does} data-call aria-pressed="false">
        <span class="dot" aria-hidden="true" />
        <span class="problem">{patchUnsure.problem}</span>
      </button>
    </div>

    <div class="card" aria-live="polite" data-card>
      <span class="label">{patchHeads.fix}</span>
      <div class="result" data-result>
        <b class="fix" data-readout="fix">{first.fix}</b>
        <p class="does" data-readout="does">{first.does}</p>
        <span class="pill"><span data-readout="time">{first.time}</span> · <span data-readout="tail">any budget</span></span>
      </div>
      <button type="button" class="flip" data-flip aria-pressed="false" aria-label="Send this to us">
        <span class="flip-track" aria-hidden="true"><span class="flip-knob"></span></span>
        <span class="flip-label" data-flip-label data-label-send={patchHeads.send} data-label-book={patchHeads.book}>{patchHeads.send}</span>
      </button>
    </div>
  </div>

  <div class="strip" aria-hidden="true">
    <span class="strip-name"><IconMark size={26} />CC-01 · CROSS-CONNECT PATCH BAY</span>
    <span class="strip-pwr">PWR <span class="led"></span></span>
  </div>
</div>

<style>
  .patchbay {
    position: relative;
    width: 100%;
    border-radius: 18px;
    padding: 34px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Faint circuit traces behind the keys and card, fading out towards the edges. */
  .pattern {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 70% 75% at 50% 50%, #000 25%, transparent 90%);
    mask-image: radial-gradient(ellipse 70% 75% at 50% 50%, #000 25%, transparent 90%);
  }

  .pattern svg {
    display: block;
  }

  .trace {
    fill: none;
    stroke: var(--trace);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pad {
    fill: none;
    stroke: var(--pad);
    stroke-width: 1.5;
  }

  .via {
    fill: var(--pad);
  }

  .body,
  .strip {
    position: relative;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 30px;
  }

  .label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--copper-text);
  }

  /* The question visitors answer first, so it reads before anything else on the panel. */
  .ask {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 4px;
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(15px, 1.4vw, 17px);
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .ask .led {
    width: 7px;
    height: 7px;
  }

  .keys {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .key {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--body);
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(13px, 1.25vw, 15px);
    line-height: 1.25;
    text-align: left;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .key:hover {
    border-color: var(--copper-line);
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--led-off);
    transition: background 0.2s, box-shadow 0.2s;
  }

  .key[aria-pressed='true'] {
    border-color: var(--copper-line);
    background: var(--sel-bg);
    color: var(--text);
    font-weight: 600;
  }

  .key[aria-pressed='true'] .dot {
    background: var(--led);
    box-shadow: 0 0 8px var(--led);
  }

  /* The cable from the picked key into the card, across the 30px gap. */
  .key[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 100%;
    top: 50%;
    width: 31px;
    height: 4px;
    margin-top: -2px;
    background: var(--copper);
    box-shadow: 0 0 0 1px var(--cable-out), inset 0 1px 0 var(--cable-hi);
  }

  .card {
    border-radius: 14px;
    border: 1px solid var(--copper-line);
    background: var(--panel-hi);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .result.swap {
    animation: swap 0.3s var(--ease);
  }

  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .fix {
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .does {
    margin: 0;
    color: var(--body);
    font-size: 16px;
  }

  .pill {
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--copper-tint);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
  }

  .flip {
    margin-top: auto;
    padding: 10px 0 0;
    border: 0;
    background: none;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
  }

  .flip-track {
    position: relative;
    width: 52px;
    height: 28px;
    border-radius: 999px;
    background: var(--sw-off);
    box-shadow: inset 0 2px 5px var(--track-inset);
    transition: background 0.3s;
  }

  .flip-knob {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sw-knob-off);
    box-shadow: 0 1px 4px var(--knob-shadow);
    transition: transform 0.35s var(--ease), background 0.3s;
  }

  .flip:hover .flip-track {
    background: var(--copper-line);
  }

  .flip[aria-pressed='true'] .flip-track {
    background: var(--copper);
  }

  .flip[aria-pressed='true'] .flip-knob {
    transform: translateX(24px);
    background: var(--on-copper);
  }

  .flip-label {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 0 4px;
    font-family: var(--mono);
    font-size: clamp(8px, 1.1vw, 10px);
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .strip-name,
  .strip-pwr {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .strip .led {
    width: 7px;
    height: 7px;
  }

  /* The "Not sure yet" key is for phones, where the hero has no call line. */
  .key.unsure {
    display: none;
    border-style: dashed;
  }

  @media (max-width: 760px) {
    .key.unsure {
      display: flex;
    }
  }

  /* Phones: keys in two columns on top, the card underneath, joined by a short drop of cable. */
  @media (max-width: 600px) {
    .patchbay {
      padding: 30px 14px 16px;
    }

    .body {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .keys {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ask {
      grid-column: 1 / -1;
    }

    .key {
      min-height: 48px;
      padding: 8px 10px;
      gap: 8px;
      font-size: 13px;
    }

    .label {
      font-size: 12px;
    }

    .card {
      padding: 18px;
    }

    .flip {
      min-height: 44px;
      padding-top: 6px;
    }

    .key[aria-pressed='true']::after {
      display: none;
    }

    .card {
      position: relative;
      margin-top: 22px;
    }

    .card::before {
      content: '';
      position: absolute;
      left: 50%;
      margin-left: -2px;
      top: -23px;
      width: 4px;
      height: 22px;
      background: var(--copper);
      box-shadow: 0 0 0 1px var(--cable-out);
    }

    .strip-name {
      font-size: 0;
    }
  }
</style>

<script>
  import { openContact } from '../scripts/contact-bus';

  const root = document.querySelector<HTMLElement>('[data-patchbay]');

  if (root) {
    const keys = Array.from(root.querySelectorAll<HTMLButtonElement>('.key'));
    const result = root.querySelector<HTMLElement>('[data-result]');
    const out = {
      fix: root.querySelector<HTMLElement>('[data-readout="fix"]'),
      does: root.querySelector<HTMLElement>('[data-readout="does"]'),
      time: root.querySelector<HTMLElement>('[data-readout="time"]'),
      tail: root.querySelector<HTMLElement>('[data-readout="tail"]'),
    };
    const card = root.querySelector<HTMLElement>('[data-card]');
    const tailText = out.tail?.textContent ?? '';
    const stacked = window.matchMedia('(max-width: 600px)');
    const flip = root.querySelector<HTMLButtonElement>('[data-flip]');
    const flipLabel = root.querySelector<HTMLElement>('[data-flip-label]');
    const flipText = () => (keys[picked].dataset.call !== undefined ? flipLabel?.dataset.labelBook : flipLabel?.dataset.labelSend) ?? '';
    let picked = 0;
    let timer: number | undefined;

    keys.forEach((key, i) =>
      key.addEventListener('click', () => {
        if (i === picked) return;
        picked = i;
        keys.forEach((k, j) => k.setAttribute('aria-pressed', String(i === j)));
        if (out.fix) out.fix.textContent = key.dataset.fix ?? '';
        if (out.does) out.does.textContent = key.dataset.does ?? '';
        if (out.time) out.time.textContent = key.dataset.time ?? '';
        if (out.tail) out.tail.textContent = key.dataset.tail ?? tailText;
        // "Not sure yet" books a call instead: booking.ts opens its dialog for any [data-book] click.
        flip?.toggleAttribute('data-book', key.dataset.call !== undefined);
        if (flipLabel) flipLabel.textContent = flipText();
        // Restart the small fade so the new fix reads as a change.
        result?.classList.remove('swap');
        void result?.offsetWidth;
        result?.classList.add('swap');
        // Phones: if the card is below the screen, bring it up so the change is seen.
        const bottom = card?.getBoundingClientRect().bottom ?? 0;
        if (stacked.matches && bottom > window.innerHeight - 12) window.scrollBy({ top: bottom - window.innerHeight + 24 });
      }),
    );

    flip?.addEventListener('click', () => {
      if (flip.hasAttribute('data-book') || flip.getAttribute('aria-pressed') === 'true') return;
      flip.setAttribute('aria-pressed', 'true');
      if (flipLabel) flipLabel.textContent = 'Sending…';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        const key = keys[picked];
        openContact({
          topic: key.dataset.topic,
          message: `Problem: ${key.querySelector('.problem')?.textContent?.trim()}. I think I need: ${key.dataset.fix}.`,
        });
        flip.setAttribute('aria-pressed', 'false');
        if (flipLabel) flipLabel.textContent = flipText();
      }, 650);
    });
  }
</script>
