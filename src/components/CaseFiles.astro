---
import { cases } from '../data/site';
---

<section id="work" class="section" data-cases>
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2">Case files.</h2>
      <p>Pick a file to see what was built and what changed.</p>
    </div>
    <div class="layout">
      <div class="list" role="group" aria-label="Case files">
        {
          cases.map((c, i) => (
            <button type="button" class="row" data-case={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`case-${i}`}>
              <span class="code">{c.code}</span>
              <span class="titles">
                <span class="title">{c.title}</span>
                <span class="sector">{c.sector}</span>
              </span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </button>
          ))
        }
      </div>

      <div class="viewer surface">
        {
          cases.map((c, i) => (
            <div class="pane" id={`case-${i}`} data-pane={i} hidden={i !== 0}>
              <div class="screen lcd" aria-hidden="true">
                {c.kind === 'chat' && (
                  <div class="chat">
                    <span class="me">Can I see the doctor tomorrow morning?</span>
                    <span class="them">Yes. 10:30 or 11:15?</span>
                    <span class="me">10:30 please</span>
                    <span class="them">Booked ✓ I’ll remind you at 9:00.</span>
                  </div>
                )}
                {c.kind === 'store' && c.screen && (
                  <div class="store">
                    <div class="tiles">
                      {c.screen.tiles.map((t) => (
                        <div class={t.warn ? 'warn' : undefined}><span>{t.label}</span><b>{t.value}</b></div>
                      ))}
                    </div>
                    {c.screen.orders.map((o) => (
                      <div class="order"><span class="mono">{o.no}</span><span>{o.item}</span><span class="ok">{o.status}</span></div>
                    ))}
                  </div>
                )}
                {c.kind === 'flow' && c.flow && (
                  <div class="flow">
                    {c.flow.map((s, j) => (
                      <>
                        {j > 0 && <i>→</i>}
                        <span class={s.hot ? 'hot' : undefined}>{s.t}</span>
                      </>
                    ))}
                  </div>
                )}
              </div>
              <div class="info">
                <div class="meta">
                  {c.example && <span class="ex">EXAMPLE</span>}
                  <span>{c.code}</span>
                  <span>{c.stack}</span>
                </div>
                <h3>{c.title}</h3>
                {c.link && (
                  <a class="visit" href={c.link.href} target="_blank" rel="noopener">
                    visit {c.link.label} ↗
                  </a>
                )}
                <dl>
                  <dt>problem</dt>
                  <dd>{c.problem}</dd>
                  <dt>built</dt>
                  <dd>{c.built}</dd>
                  <dt>result</dt>
                  <dd class="strong">{c.result}</dd>
                </dl>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: flex-start;
  }

  .list {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .row {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 22px 18px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    text-align: left;
    transition: background 0.25s;
  }

  .row:hover {
    background: var(--fill);
  }

  .row[aria-pressed='true'] {
    background: var(--sel-bg);
  }

  .code,
  .arrow {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .arrow {
    font-size: 18px;
  }

  .row[aria-pressed='true'] .code,
  .row[aria-pressed='true'] .arrow {
    color: var(--copper-text);
  }

  .titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .title {
    font-weight: 700;
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.25;
  }

  .sector {
    font-size: 14px;
    color: var(--muted);
  }

  .viewer {
    flex: 1 1 520px;
    min-width: 0;
    position: sticky;
    top: 96px;
    border-radius: 20px;
    padding: 14px;
  }

  .screen {
    height: 290px;
    border-radius: 12px;
    padding: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: inset 0 0 50px var(--lcd-inset);
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 14px;
  }

  .chat span {
    max-width: 75%;
    padding: 9px 13px;
  }

  .chat .me {
    align-self: flex-end;
    border-radius: 14px 14px 3px 14px;
    background: var(--copper-tint);
    border: 1px solid var(--copper-line);
  }

  .chat .them {
    align-self: flex-start;
    border-radius: 14px 14px 14px 3px;
    background: var(--lcd-bubble);
  }

  .store {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 13px;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .tiles div {
    padding: 12px;
    border-radius: 10px;
    background: var(--lcd-bubble);
    display: flex;
    flex-direction: column;
  }

  .tiles span {
    color: var(--lcd-muted);
  }

  .tiles b {
    font-family: var(--mono);
    font-weight: 600;
    font-size: 22px;
  }

  .tiles .warn {
    background: var(--copper-tint);
    border: 1px solid var(--copper-line);
  }

  .tiles .warn span {
    color: var(--lcd-text);
  }

  .order {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 10px;
    background: var(--lcd-bubble);
  }

  .order span:nth-child(2) {
    color: var(--lcd-muted);
  }

  .ok {
    color: var(--lcd-accent);
  }

  .flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 13px;
  }

  .flow span {
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--lcd-bubble);
  }

  .flow .hot {
    background: var(--copper-tint);
    border: 1px solid var(--copper);
  }

  .flow i {
    font-style: normal;
    color: var(--lcd-accent);
  }

  .info {
    padding: 22px 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .ex {
    color: var(--copper-text);
  }

  h3 {
    margin: 0;
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.01em;
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 8px 14px;
    font-size: 15px;
  }

  dt {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    padding-top: 3px;
  }

  dd {
    margin: 0;
    color: var(--body);
  }

  dd.strong {
    color: var(--text);
  }

  .visit {
    align-self: flex-start;
    margin: -4px 0 4px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--copper-text);
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .viewer {
      position: static;
    }
  }

  @media (max-width: 480px) {
    dl {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    dd {
      margin-bottom: 8px;
    }

    .screen {
      height: auto;
      min-height: 240px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-cases]');
  if (root) {
    const rows = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-case]'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-pane]'));
    rows.forEach((row, i) =>
      row.addEventListener('click', () => {
        rows.forEach((r, j) => r.setAttribute('aria-pressed', String(i === j)));
        panes.forEach((p, j) => (p.hidden = i !== j));
      }),
    );
  }
</script>
