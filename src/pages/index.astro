---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseFiles from '../components/CaseFiles.astro';
import ContactDialog from '../components/ContactDialog.astro';
import ContactSection from '../components/ContactSection.astro';
import Faq from '../components/Faq.astro';
import FieldReports from '../components/FieldReports.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PatchedIn from '../components/PatchedIn.astro';
import Pricing from '../components/Pricing.astro';
import Rack from '../components/Rack.astro';
import Rails from '../components/Rails.astro';
import SignalPath from '../components/SignalPath.astro';
import { contact, faqs, modules, site } from '../data/site';

// Structured data for search engines: who we are, what we offer, and the FAQ.
// Anything still a [placeholder] is left out.
const real = (text: string) => !text.includes('[');
const home = Astro.site?.href ?? Astro.url.href;
const org = `${home}#org`;
const structured = [
  // Tells Google which name to show above the result instead of the bare domain.
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${home}#website`,
    name: site.name,
    alternateName: site.altNames,
    url: home,
    inLanguage: 'en-IN',
    publisher: { '@id': org },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': org,
    name: site.name,
    url: home,
    areaServed: site.areaServed,
    address: { '@type': 'PostalAddress', addressCountry: 'IN' },
    sameAs: site.profiles.length ? site.profiles : undefined,
    description: site.description,
    logo: new URL('/apple-touch-icon.png', home).href,
    image: new URL('/og-image.png', home).href,
    email: contact.email || undefined,
    telephone: contact.whatsapp ? `+${contact.whatsapp}` : undefined,
    priceRange: 'No minimum budget',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Services',
      itemListElement: modules.map((m) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: m.name, description: m.desc, url: new URL(`/services/${m.slug}/`, home).href } })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs
      .filter((f) => real(f.q) && real(f.a))
      .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structured)} />
  <div class="page">
    <Rails />
    <Header />
    <main id="main">
      <Hero />
      <PatchedIn />
      <Rack />
      <CaseFiles />
      <Pricing />
      <SignalPath />
      <FieldReports />
      <Faq />
      <ContactSection />
    </main>
  </div>
  <ContactDialog />
</BaseLayout>

<style>
  .page {
    position: relative;
  }
</style>
