---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout title="Page not found · Cross-Connect Labs" noindex>
  <main id="main" class="wrap lost" data-not-found>
    <a href="/" aria-label="Cross-Connect Labs home"><Logo height={42} /></a>
    <p class="code">E404 · NO SIGNAL</p>
    <h1>This cable isn’t plugged in.</h1>
    <p>The page you are looking for does not exist or has moved.</p>
    <a class="cable-link" href="/">back to the home page <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>

<style>
  .lost {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
    padding-top: 48px;
    padding-bottom: 48px;
  }

  .code {
    margin: 24px 0 0;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--copper-text);
  }

  h1 {
    margin: 0;
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  p {
    margin: 0;
    color: var(--body);
  }
</style>
