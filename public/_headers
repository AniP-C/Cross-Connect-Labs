# Cloudflare Pages response headers. Docs: https://developers.cloudflare.com/pages/configuration/headers/
# (nginx.conf sets the same headers for the Docker image.)

# Astro puts CSS, JS and fonts in /_astro/ with a content hash in the name,
# so they can be cached for a year: a change produces a new file name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Basic security headers for every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
